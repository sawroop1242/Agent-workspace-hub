{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AWH checkpoint state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "operation_id",
    "recovery_attempt",
    "recovery_claim",
    "active_feature",
    "active_pr",
    "active_branch",
    "active_pr_sha",
    "review_round",
    "builder_attempt",
    "last_error",
    "last_review",
    "updated_at"
  ],
  "properties": {
    "version": {"const": 4},
    "status": {
      "type": "string",
      "enum": ["IDLE", "PLANNING", "BUILDING", "PR_OPEN", "REVIEWING", "FIXING", "MERGING", "COMPLETED", "BLOCKED", "RECOVERING"]
    },
    "operation_id": {"type": ["string", "null"]},
    "recovery_attempt": {"type": "integer", "minimum": 0},
    "recovery_claim": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id", "feature_id", "attempt", "claimed_at", "owner", "stale_status"],
          "properties": {
            "operation_id": {"type": ["string", "null"]},
            "feature_id": {"type": ["string", "null"]},
            "attempt": {"type": "integer", "minimum": 1},
            "claimed_at": {"type": "string"},
            "owner": {"type": "string", "minLength": 1},
            "stale_status": {
              "type": "string",
              "enum": ["PLANNING", "BUILDING", "PR_OPEN", "REVIEWING", "FIXING", "MERGING", "RECOVERING"]
            }
          }
        }
      ]
    },
    "active_feature": {"type": ["string", "null"]},
    "active_pr": {"type": ["integer", "null"], "minimum": 1},
    "active_branch": {"type": ["string", "null"]},
    "active_pr_sha": {"type": ["string", "null"]},
    "review_round": {"type": "integer", "minimum": 0},
    "builder_attempt": {"type": "integer", "minimum": 0},
    "last_error": {"type": ["string", "null"]},
    "last_review": {"type": "string"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
