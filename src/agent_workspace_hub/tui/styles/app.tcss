Screen { align: center middle; }
Header { height: 3; background: $primary; color: $text; }
Footer { height: 1; background: $surface; color: $text-muted; }
#home-container { layout: vertical; height: 100%; padding: 1; }
#server-panel { height: auto; border: solid $primary; padding: 1; }
.title { width: auto; text-style: bold; padding: 0 2 0 0; }
#server-status { width: auto; padding: 0 0 0 2; }
#log-panel { height: 1fr; border: solid $primary-darken-2; padding: 1; }
LogViewer { height: 100%; border: solid $surface-lighten-1; background: $surface-darken-1; }
Button { margin: 0 1; }
DataTable { height: 100%; border: solid $surface-lighten-1; }
TabPane { padding: 1; }
.approval-card { border: solid $warning; padding: 1; margin: 1 0; }
